import discord

from discord.ext import commands

from discord import app_commands

import json

import os

import random

import time

import asyncio

from typing import Optional





# ============================================================

# CONFIGURATION

# ============================================================



DATA_FILE = "levelling_data.json"



LEVEL_UP_CHANNEL_ID = 1503429577341407274



OWNER_ID = 937242913535033404



MILESTONE_ROLES = {

    10: 1503429429211168870,

    20: 1503429428439548014,

    30: 1503429426858299473,

    40: 1503429425604202696,

    50: 1503429424278933625,

    60: 1503429422567653458,

    70: 1503429421141458944,

    80: 1503429419312742502,

    90: 1503429418306113649,

    100: 1503429417391882381,

}



PREMIUM_ROLE_ID = 1503429265415471224



XP_COOLDOWN = 60

LEVEL_UP_ANNOUNCEMENT_COOLDOWN = 5



MIN_XP = 15

MAX_XP = 25



MAX_LEVEL = 100





# ============================================================

# DATA STORAGE

# ============================================================



def load_data():

    if not os.path.exists(DATA_FILE):

        return {}



    try:

        with open(DATA_FILE, "r", encoding="utf-8") as file:

            return json.load(file)

    except (json.JSONDecodeError, OSError):

        return {}





def save_data(data):

    temp_file = DATA_FILE + ".tmp"



    with open(temp_file, "w", encoding="utf-8") as file:

        json.dump(data, file, indent=4)



    os.replace(temp_file, DATA_FILE)





# ============================================================

# LEVEL CALCULATIONS

# ============================================================



def xp_required(level: int) -> int:

    """

    Total XP required to reach a level.



    Formula:

        50 × level²

    """



    if level <= 0:

        return 0



    return 50 * (level ** 2)





def calculate_level(total_xp: int) -> int:

    """

    Calculate the highest level reached from total XP.

    """



    if total_xp <= 0:

        return 0



    level = int((total_xp / 50) ** 0.5)



    while xp_required(level + 1) <= total_xp and level < MAX_LEVEL:

        level += 1



    while level > 0 and xp_required(level) > total_xp:

        level -= 1



    return min(level, MAX_LEVEL)





def xp_to_next_level(level: int, total_xp: int):

    if level >= MAX_LEVEL:

        return 0



    next_level = level + 1

    required = xp_required(next_level)



    return max(0, required - total_xp)





# ============================================================

# PREMIUM / BOOSTER MULTIPLIER

# ============================================================



def get_xp_multiplier(member: discord.Member) -> int:

    """

    Premium = 3x



    Booster = 2x



    Premium + Booster = 3x

    """



    premium = member.get_role(PREMIUM_ROLE_ID) is not None



    booster = member.premium_since is not None



    if premium:

        return 3



    if booster:

        return 2



    return 1





# ============================================================

# LEVELLING COG

# ============================================================



class Levelling(commands.Cog):



    def __init__(self, bot: commands.Bot):

        self.bot = bot



        self.data = load_data()



        # Prevent simultaneous writes.

        self.data_lock = asyncio.Lock()



        # Last time a level-up announcement was sent.

        self.last_level_up_announcement = 0.0



        # Queue for level-up announcements.

        self.level_up_queue = asyncio.Queue()



        # Start announcement worker.

        self.bot.loop.create_task(self.level_up_worker())



    # ========================================================

    # MEMBER DATA

    # ========================================================



    def get_member_data(self, guild_id: int, user_id: int):

        guild_id = str(guild_id)

        user_id = str(user_id)



        if guild_id not in self.data:

            self.data[guild_id] = {}



        if user_id not in self.data[guild_id]:

            self.data[guild_id][user_id] = {

                "total_xp": 0,

                "level": 0,

                "last_xp_award": 0,

                "level_up_notifications": True,

            }



        return self.data[guild_id][user_id]



    async def delete_member_data(self, user_id: int) -> bool:

        """

        Delete this user's levelling records from all stored guilds.

        """



        deleted = False



        async with self.data_lock:

            for guild_id in list(self.data.keys()):

                guild_data = self.data.get(guild_id)



                if not isinstance(guild_data, dict):

                    continue



                if str(user_id) in guild_data:

                    del guild_data[str(user_id)]

                    deleted = True



                if not guild_data:

                    del self.data[guild_id]



            if deleted:

                save_data(self.data)



        return deleted



    # ========================================================

    # XP AWARD

    # ========================================================



    async def award_xp(self, message: discord.Message):



        if not message.guild:

            return



        if message.author.bot:

            return



        if message.webhook_id is not None:

            return



        if not isinstance(message.author, discord.Member):

            return



        # Ignore messages shorter than 3 characters.

        if len(message.content.strip()) < 3:

            return



        member = message.author

        guild_id = message.guild.id

        user_id = member.id



        async with self.data_lock:



            member_data = self.get_member_data(

                guild_id,

                user_id

            )



            now = time.time()



            # 60 second cooldown.

            if now - member_data["last_xp_award"] < XP_COOLDOWN:

                return



            # ------------------------------------------------

            # Repeated-message protection

            # ------------------------------------------------



            normalized = " ".join(

                message.content.lower().split()

            )



            last_message = member_data.get(

                "last_message",

                ""

            )



            if normalized == last_message:

                return



            member_data["last_message"] = normalized

            member_data["last_xp_award"] = now



            # ------------------------------------------------

            # XP

            # ------------------------------------------------



            base_xp = random.randint(MIN_XP, MAX_XP)

            multiplier = get_xp_multiplier(member)



            gained_xp = base_xp * multiplier



            old_level = member_data["level"]



            member_data["total_xp"] += gained_xp



            new_level = calculate_level(

                member_data["total_xp"]

            )



            # Cap at Level 100.

            if new_level > MAX_LEVEL:

                new_level = MAX_LEVEL



            member_data["level"] = new_level



            save_data(self.data)



        # ----------------------------------------------------

        # Level-up handling

        # ----------------------------------------------------



        if new_level > old_level:



            await self.handle_level_up(

                member,

                old_level,

                new_level,

                member_data["total_xp"]

            )



    # ========================================================

    # LEVEL-UP HANDLER

    # ========================================================



    async def handle_level_up(

        self,

        member: discord.Member,

        old_level: int,

        new_level: int,

        total_xp: int

    ):



        # Update milestone role immediately.

        await self.update_milestone_role(

            member,

            new_level

        )



        # Queue ONE announcement even if multiple levels

        # were gained at once.

        await self.level_up_queue.put(

            (

                member,

                new_level,

                total_xp

            )

        )



    # ========================================================

    # MILESTONE ROLES

    # ========================================================



    async def update_milestone_role(

        self,

        member: discord.Member,

        level: int

    ):



        guild = member.guild



        reached_milestone = None



        for milestone in sorted(

            MILESTONE_ROLES.keys(),

            reverse=True

        ):

            if level >= milestone:

                reached_milestone = milestone

                break



        # Remove all milestone roles except the new highest.

        roles_to_remove = []



        for milestone, role_id in MILESTONE_ROLES.items():



            if role_id == 0:

                continue



            role = guild.get_role(role_id)



            if role is None:

                continue



            if role in member.roles:



                if milestone != reached_milestone:

                    roles_to_remove.append(role)



        if roles_to_remove:



            try:

                await member.remove_roles(

                    *roles_to_remove,

                    reason="Chatly levelling milestone update"

                )

            except discord.HTTPException:

                pass



        # Add the new milestone role.

        if reached_milestone is not None:



            role_id = MILESTONE_ROLES.get(

                reached_milestone

            )



            if role_id:

                role = guild.get_role(role_id)



                if role and role not in member.roles:



                    try:

                        await member.add_roles(

                            role,

                            reason="Chatly levelling milestone"

                        )

                    except discord.HTTPException:

                        pass



    # ========================================================

    # LEVEL-UP ANNOUNCEMENT WORKER

    # ========================================================



    async def level_up_worker(self):



        await self.bot.wait_until_ready()



        while not self.bot.is_closed():



            member, level, total_xp = (

                await self.level_up_queue.get()

            )



            # Global 5 second cooldown.

            now = time.time()



            wait_time = (

                LEVEL_UP_ANNOUNCEMENT_COOLDOWN

                - (now - self.last_level_up_announcement)

            )



            if wait_time > 0:

                await asyncio.sleep(wait_time)



            await self.send_level_up(

                member,

                level,

                total_xp

            )



            self.last_level_up_announcement = time.time()



            self.level_up_queue.task_done()



    # ========================================================

    # SEND LEVEL-UP MESSAGE

    # ========================================================



    async def send_level_up(

        self,

        member: discord.Member,

        level: int,

        total_xp: int

    ):



        channel = self.bot.get_channel(

            LEVEL_UP_CHANNEL_ID

        )



        if channel is None:

            return



        data = self.get_member_data(

            member.guild.id,

            member.id

        )



        notifications_enabled = data.get(

            "level_up_notifications",

            True

        )



        if level >= MAX_LEVEL:

            progress = f"{total_xp:,} XP"

            next_text = "You've reached the maximum level!"

        else:

            next_required = xp_required(level + 1)



            progress = (

                f"{total_xp:,} / "

                f"{next_required:,} XP"

            )



            next_text = (

                f"Keep chatting to reach "

                f"Level {level + 1}."

            )



        embed = discord.Embed(

            title="<:uparrow:1550289381347295292> Level Up!",

            description=(

                f"**{member.display_name}** reached "

                f"**<:rocket:1552322699379081246> Level {level}!**\n\n"

                f"`{progress}`\n"

                f"{next_text}"

            ),

            color=discord.Color.from_str(

                "#52FB18"

            )

        )



        embed.set_thumbnail(

            url=member.display_avatar.url

        )



        if notifications_enabled:

            content = member.mention

        else:

            content = None



        try:

            await channel.send(

                content=content,

                embed=embed,

                allowed_mentions=discord.AllowedMentions(

                    users=True

                )

            )

        except discord.HTTPException:

            pass



    # ========================================================

    # MESSAGE LISTENER

    # ========================================================



    @commands.Cog.listener()

    async def on_message(self, message: discord.Message):



        await self.award_xp(message)



    # ========================================================

    # /RANK

    # ========================================================



    @app_commands.command(

        name="rank",

        description="View your or another member's Chatly level."

    )



    @app_commands.describe(

        member="The member whose rank you want to view."

    )



    async def rank(

        self,

        interaction: discord.Interaction,

        member: Optional[discord.Member] = None

    ):



        member = member or interaction.user



        if not interaction.guild:

            await interaction.response.send_message(

                "❌ This command can only be used in a server.",

                ephemeral=True

            )

            return



        data = self.get_member_data(

            interaction.guild.id,

            member.id

        )



        total_xp = data["total_xp"]

        level = calculate_level(total_xp)



        # ----------------------------------------------------

        # Server rank

        # ----------------------------------------------------



        guild_data = self.data.get(

            str(interaction.guild.id),

            {}

        )



        rankings = []



        for user_id, user_data in guild_data.items():



            if user_data.get("total_xp", 0) > 0:



                rankings.append(

                    (

                        int(user_id),

                        user_data.get(

                            "total_xp",

                            0

                        )

                    )

                )



        rankings.sort(

            key=lambda x: x[1],

            reverse=True

        )



        server_rank = "Unranked"



        for index, (user_id, _) in enumerate(

            rankings,

            start=1

        ):



            if user_id == member.id:

                server_rank = f"#{index}"

                break



        # ----------------------------------------------------

        # Progress

        # ----------------------------------------------------



        if level >= MAX_LEVEL:

            progress = "MAX LEVEL"

        else:

            current_requirement = xp_required(level)

            next_requirement = xp_required(level + 1)



            progress = (

                f"{total_xp - current_requirement:,} / "

                f"{next_requirement - current_requirement:,} XP"

            )



        embed = discord.Embed(

            title=f"<:trophee:1552322681251176641> {member.display_name}'s Rank",

            color=discord.Color.from_str(

                "#52FB18"

            )

        )



        embed.set_thumbnail(

            url=member.display_avatar.url

        )



        embed.add_field(

            name="<:rocket:1552322699379081246> Level",

            value=f"**{level}**",

            inline=True

        )



        embed.add_field(

            name="<:stars:1550289412624093234> Total XP",

            value=f"**{total_xp:,}**",

            inline=True

        )



        embed.add_field(

            name="Server Rank",

            value=f"**{server_rank}**",

            inline=True

        )



        embed.add_field(

            name="Progress",

            value=f"`{progress}`",

            inline=False

        )



        await interaction.response.send_message(

            embed=embed

        )



    # ========================================================

    # /LEADERBOARD

    # ========================================================



    @app_commands.command(

        name="leaderboard",

        description="View the Chatly XP leaderboard."

    )



    async def leaderboard(

        self,

        interaction: discord.Interaction

    ):



        if not interaction.guild:

            await interaction.response.send_message(

                "❌ This command can only be used in a server.",

                ephemeral=True

            )

            return



        await interaction.response.send_message(

            embed=self.create_leaderboard_embed(

                interaction.guild,

                page=0

            ),

            view=LeaderboardView(

                self,

                interaction.guild,

                interaction.user.id

            )

        )



    # ========================================================

    # LEADERBOARD EMBED

    # ========================================================



    def create_leaderboard_embed(

        self,

        guild: discord.Guild,

        page: int

    ):



        guild_data = self.data.get(

            str(guild.id),

            {}

        )



        members = []



        for user_id, data in guild_data.items():



            total_xp = data.get(

                "total_xp",

                0

            )



            if total_xp <= 0:

                continue



            member = guild.get_member(

                int(user_id)

            )



            if member is None:

                continue



            if member.bot:

                continue



            members.append(

                (

                    member,

                    total_xp,

                    calculate_level(total_xp)

                )

            )



        members.sort(

            key=lambda x: x[1],

            reverse=True

        )



        per_page = 10



        total_pages = max(

            1,

            (len(members) + per_page - 1)

            // per_page

        )



        page = max(

            0,

            min(page, total_pages - 1)

        )



        start = page * per_page

        end = start + per_page



        page_members = members[

            start:end

        ]



        embed = discord.Embed(

            title="<:trophee:1552322681251176641> Chatly XP Leaderboard",

            color=discord.Color.from_str(

                "#52FB18"

            )

        )



        if not page_members:



            embed.description = (

                "No members have earned XP yet."

            )



        else:



            lines = []



            for index, (

                member,

                total_xp,

                level

            ) in enumerate(

                page_members,

                start=start + 1

            ):



                lines.append(

                    f"**#{index}** "

                    f"{member.mention} — "

                    f"<:rocket:1552322699379081246> Level **{level}** — "

                    f"<:stars:1550289412624093234> `{total_xp:,} XP`"

                )



            embed.description = "\n".join(

                lines

            )



        embed.set_footer(

            text=(

                f"Page {page + 1}/{total_pages} "

                f"• {len(members)} members"

            )

        )



        return embed





# ============================================================

# LEADERBOARD BUTTON VIEW

# ============================================================



class LeaderboardView(discord.ui.View):



    def __init__(

        self,

        cog: Levelling,

        guild: discord.Guild,

        author_id: int

    ):



        super().__init__(

            timeout=300

        )



        self.cog = cog

        self.guild = guild

        self.author_id = author_id

        self.page = 0



    async def interaction_check(

        self,

        interaction: discord.Interaction

    ):



        if interaction.user.id != self.author_id:



            await interaction.response.send_message(

                "❌ Only the person who opened this leaderboard can use these buttons.",

                ephemeral=True

            )



            return False



        return True



    @discord.ui.button(

        label="Previous",

        emoji="<:previous:1552322765959331940>",

        style=discord.ButtonStyle.secondary

    )



    async def previous(

        self,

        interaction: discord.Interaction,

        button: discord.ui.Button

    ):



        if self.page > 0:

            self.page -= 1



        await interaction.response.edit_message(

            embed=self.cog.create_leaderboard_embed(

                self.guild,

                self.page

            ),

            view=self

        )



    @discord.ui.button(

        label="Next",

        emoji="<:next:1552322743201046609>",

        style=discord.ButtonStyle.secondary

    )



    async def next(

        self,

        interaction: discord.Interaction,

        button: discord.ui.Button

    ):



        guild_data = self.cog.data.get(

            str(self.guild.id),

            {}

        )



        members = [

            user_id

            for user_id, data in guild_data.items()

            if data.get("total_xp", 0) > 0

            and self.guild.get_member(

                int(user_id)

            ) is not None

        ]



        total_pages = max(

            1,

            (len(members) + 9) // 10

        )



        if self.page < total_pages - 1:

            self.page += 1



        await interaction.response.edit_message(

            embed=self.cog.create_leaderboard_embed(

                self.guild,

                self.page

            ),

            view=self

        )



    @discord.ui.button(

        label="Refresh",

        emoji="<:refresh:1550282774714519664>",

        style=discord.ButtonStyle.primary

    )



    async def refresh(

        self,

        interaction: discord.Interaction,

        button: discord.ui.Button

    ):



        await interaction.response.edit_message(

            embed=self.cog.create_leaderboard_embed(

                self.guild,

                self.page

            ),

            view=self

        )





# ============================================================

# /LEVEL-NOTIFICATIONS

# ============================================================



@app_commands.guild_only()

class NotificationCommands:

    pass





class LevelNotificationView(discord.ui.View):



    def __init__(self, cog: Levelling):

        super().__init__(

            timeout=60

        )



        self.cog = cog



    @discord.ui.button(

        label="🔔 Level-Up Notifications",

        style=discord.ButtonStyle.primary

    )



    async def toggle(

        self,

        interaction: discord.Interaction,

        button: discord.ui.Button

    ):



        if not interaction.guild:

            return



        async with self.cog.data_lock:



            data = self.cog.get_member_data(

                interaction.guild.id,

                interaction.user.id

            )



            current = data.get(

                "level_up_notifications",

                True

            )



            data[

                "level_up_notifications"

            ] = not current



            save_data(self.cog.data)



            new_value = not current



        status = (

            "enabled 🔔"

            if new_value

            else "disabled 🔕"

        )



        await interaction.response.send_message(

            f"Level-up notifications are now **{status}**.",

            ephemeral=True

        )





# ============================================================

# COMMANDS COG

# ============================================================



class LevellingCommands(commands.Cog):



    def __init__(self, bot):

        self.bot = bot



    @app_commands.command(

        name="level-notifications",

        description="Toggle your level-up notifications."

    )



    async def level_notifications(

        self,

        interaction: discord.Interaction

    ):



        cog = self.bot.get_cog("Levelling")



        if cog is None:

            await interaction.response.send_message(

                "❌ Levelling system is unavailable.",

                ephemeral=True

            )

            return



        data = cog.get_member_data(

            interaction.guild.id,

            interaction.user.id

        )



        enabled = data.get(

            "level_up_notifications",

            True

        )



        status = (

            "enabled 🔔"

            if enabled

            else "disabled 🔕"

        )



        await interaction.response.send_message(

            f"Your level-up notifications are currently **{status}**.\n\n"

            "Use the button below to toggle them.",

            view=LevelNotificationView(cog),

            ephemeral=True

        )



    # ========================================================

    # STAFF: /SET-LEVEL

    # ========================================================



    async def _staff_check(self, interaction: discord.Interaction) -> bool:

        if not interaction.guild:

            await interaction.response.send_message(

                "❌ This command can only be used in a server.",

                ephemeral=True

            )

            return False



        if interaction.user.id == OWNER_ID:

            return True



        if (

            isinstance(interaction.user, discord.Member)

            and interaction.user.guild_permissions.manage_guild

        ):

            return True



        await interaction.response.send_message(

            "❌ You do not have permission to use this command.",

            ephemeral=True

        )

        return False



    @app_commands.command(

        name="set-level",

        description="Staff: Set a member's level."

    )



    @app_commands.default_permissions(

        manage_guild=True

    )



    @app_commands.describe(

        member="Member to modify.",

        level="Level to set."

    )



    async def set_level(

        self,

        interaction: discord.Interaction,

        member: discord.Member,

        level: app_commands.Range[

            int,

            0,

            MAX_LEVEL

        ]

    ):



        if not await self._staff_check(interaction):

            return



        cog = self.bot.get_cog("Levelling")



        async with cog.data_lock:



            data = cog.get_member_data(

                interaction.guild.id,

                member.id

            )



            data["level"] = level

            data["total_xp"] = xp_required(level)



            save_data(cog.data)



        await cog.update_milestone_role(

            member,

            level

        )



        await interaction.response.send_message(

            f"✅ Set {member.mention}'s level to **{level}**.",

            ephemeral=True

        )



    # ========================================================

    # STAFF: /ADD-XP

    # ========================================================



    @app_commands.command(

        name="add-xp",

        description="Staff: Add XP to a member."

    )



    @app_commands.default_permissions(

        manage_guild=True

    )



    @app_commands.describe(

        member="Member to modify.",

        amount="Amount of XP to add."

    )



    async def add_xp(

        self,

        interaction: discord.Interaction,

        member: discord.Member,

        amount: app_commands.Range[

            int,

            1,

            1000000

        ]

    ):



        if not await self._staff_check(interaction):

            return



        cog = self.bot.get_cog("Levelling")



        async with cog.data_lock:



            data = cog.get_member_data(

                interaction.guild.id,

                member.id

            )



            old_level = calculate_level(

                data["total_xp"]

            )



            data["total_xp"] += amount



            if data["total_xp"] > xp_required(

                MAX_LEVEL

            ):

                data["total_xp"] = xp_required(

                    MAX_LEVEL

                )



            new_level = calculate_level(

                data["total_xp"]

            )



            data["level"] = new_level



            save_data(cog.data)



        if new_level > old_level:

            await cog.handle_level_up(

                member,

                old_level,

                new_level,

                data["total_xp"]

            )



        await interaction.response.send_message(

            f"✅ Added **{amount:,} XP** to {member.mention}.\n"

            f"New level: **{new_level}**",

            ephemeral=True

        )



    # ========================================================

    # STAFF: /REMOVE-XP

    # ========================================================



    @app_commands.command(

        name="remove-xp",

        description="Staff: Remove XP from a member."

    )



    @app_commands.default_permissions(

        manage_guild=True

    )



    @app_commands.describe(

        member="Member to modify.",

        amount="Amount of XP to remove."

    )



    async def remove_xp(

        self,

        interaction: discord.Interaction,

        member: discord.Member,

        amount: app_commands.Range[

            int,

            1,

            1000000

        ]

    ):



        if not await self._staff_check(interaction):

            return



        cog = self.bot.get_cog("Levelling")



        async with cog.data_lock:



            data = cog.get_member_data(

                interaction.guild.id,

                member.id

            )



            data["total_xp"] = max(

                0,

                data["total_xp"] - amount

            )



            new_level = calculate_level(

                data["total_xp"]

            )



            data["level"] = new_level



            save_data(cog.data)



        await cog.update_milestone_role(

            member,

            new_level

        )



        await interaction.response.send_message(

            f"✅ Removed **{amount:,} XP** from {member.mention}.\n"

            f"New level: **{new_level}**",

            ephemeral=True

        )





# ============================================================

# SETUP

# ============================================================



async def setup(bot: commands.Bot):



    await bot.add_cog(

        Levelling(bot)

    )



    await bot.add_cog(

        LevellingCommands(bot)

    )